{
  "name": "todos-training-cli",
  "version": "0.0.0",
  "description": "CLI foundation for Todos training",
  "type": "module",
  "files": [
    "dist",
    "!dist/test"
  ],
  "bin": {
    "todos-cli": "./dist/index.js"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json && chmod +x dist/index.js",
    "build:install": "pnpm build && npm install --global .",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "pack": "pnpm test && npm pack --dry-run"
  },
  "dependencies": {
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  }
}
