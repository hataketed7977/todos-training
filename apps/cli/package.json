{
  "name": "@bytedance/todo-cli",
  "version": "0.0.0",
  "description": "Command-line client for the Todos API",
  "type": "module",
  "files": [
    "dist",
    "!dist/test"
  ],
  "bin": {
    "todo-cli": "./dist/index.js"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "test": "pnpm build && node --test dist/test/cli.test.js",
    "prepublishOnly": "pnpm test",
    "pack:check": "pnpm test && npm pack --dry-run",
    "install:global": "pnpm build && npm install --global .",
    "todo-cli": "pnpm build && node dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  }
}
